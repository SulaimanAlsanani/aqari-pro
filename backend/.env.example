APP_NAME="Aqari Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
LOG_CHANNEL=stderr
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# In production configure a real SMTP provider, never keep the log mailer.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.invalid
MAIL_FROM_NAME="Aqari Pro"

# Private attachments: in production ClamAV scanning is mandatory and fails closed.
# Install ClamAV and refresh virus signatures before allowing real uploads.
DOCUMENT_SCAN_ENABLED=false
DOCUMENT_CLAMSCAN_BINARY=/usr/bin/clamscan
DOCUMENT_SCAN_TIMEOUT=30

# Dedicated private S3-compatible object-storage credentials. Do not reuse attachment keys.
# Grant write/read/delete only to the designated backup bucket; enable retention/versioning at the provider.
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false

# Mandatory distinct encryption key for encrypted snapshots; generate with: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Store key separately from the backup bucket and maintain secure off-site key escrow.
BACKUP_ENCRYPTION_KEY=

# Opt-in read-only hourly backup freshness monitoring. Does NOT schedule backups.
BACKUP_MONITOR_ENABLED=false
BACKUP_MAX_AGE_HOURS=26
