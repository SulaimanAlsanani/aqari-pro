# CI ONLY: ephemeral internal CA and loopback-mounted port 18443.
# Never deploy this configuration on an internet-facing staging server.
staging.example.test {
  tls internal
  encode gzip
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
  }
  @home path /
  redir @home /staging/ 302
  reverse_proxy app:80
}
