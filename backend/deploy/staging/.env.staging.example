# Copy to .env.staging on a private staging host; NEVER commit that file.
# Use a real DNS name whose A/AAAA record points at your server.
AQARI_DOMAIN=staging.example.com
# Generate independently: php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
AQARI_APP_KEY=
# Use a long, unique, securely generated database password.
AQARI_DB_PASSWORD=
